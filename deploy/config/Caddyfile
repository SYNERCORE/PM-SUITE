# Caddy 2 reverse proxy + static host for ProMaster.
#
# Phase 1: Caddy serves promaster.html directly AND proxies /api/* to Node.
# One URL for the whole app — replaces GitHub Pages / SharePoint hosting.
#
# Location on disk:
#   Ubuntu   /etc/caddy/Caddyfile                     (systemctl reload caddy)
#   Windows  C:\Program Files\Caddy\Caddyfile         (Restart-Service caddy)
#
# The hostname must resolve to this server on the LAN (internal DNS or
# hosts file on each client). For internal-only HTTPS Caddy issues its
# own cert from a local CA — install that root CA on each client machine.

procmaster.synercore.ph {
    # Public hostname — Caddy will auto-fetch a Let's Encrypt cert
    # if this server is reachable on port 80/443 from the internet
    # (needed once during cert issuance).

    encode zstd gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        X-Frame-Options           "DENY"
        -Server
    }

    # API and health — proxy to the Node service on localhost:3000
    handle /api/* {
        reverse_proxy 127.0.0.1:3000
    }
    handle /health {
        reverse_proxy 127.0.0.1:3000
    }

    # Everything else — serve the built app
    handle {
        # Windows: C:\ProcMaster-Web
        # Ubuntu:  /var/www/procmaster
        root * C:\ProcMaster-Web
        try_files {path} /promaster.html
        file_server
    }

    log {
        # Windows: C:\ProcMaster\logs\access.log
        # Ubuntu:  /var/log/caddy/procmaster.log
        output file C:\ProcMaster\logs\access.log {
            roll_size 50MiB
            roll_keep 10
        }
        format json
    }
}
